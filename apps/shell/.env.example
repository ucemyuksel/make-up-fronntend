# Vercel / üretim için kopyala-doldur şablonu (yerel değerler .env.local'de).
AUTH_SECRET=uretimde-guclu-bir-secret-uret   # openssl rand -hex 32
AUTH_TRUST_HOST=true
KEYCLOAK_ISSUER=https://auth.alanadi.com/realms/makeup
KEYCLOAK_CLIENT_ID=makeup-web
KEYCLOAK_CLIENT_SECRET=keycloak-client-secret

# Multi-Zones: diğer zone'ların dağıtım URL'leri
RECIPES_URL=https://glamguide-recipes.vercel.app
STORE_URL=https://glamguide-store.vercel.app
SOCIAL_URL=https://glamguide-social.vercel.app

# Backend API'leri (Dokploy domain'leri)
STORE_API=https://api.alanadi.com/store
POST_API=https://api.alanadi.com/post
MESSAGING_API=https://api.alanadi.com/messaging
REELS_API=https://api.alanadi.com/reels
PURCHASE_API=https://api.alanadi.com/purchase
